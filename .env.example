# ─── PMI Uganda Clubs · environment ──────────────────────────────────────────
# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase Postgres (Supabase dashboard → Connect → ORMs → Prisma)
# Transaction pooler, used by the app at runtime (port 6543):
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct / session connection, used by Prisma CLI for db push (port 5432):
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase Storage (Project settings → API). Service role key is SERVER-ONLY — never prefix with NEXT_PUBLIC_.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"

# App
APP_URL="http://localhost:3000"           # production: https://your-domain
AUTH_SECRET=""                             # openssl rand -base64 32
CRON_SECRET=""                             # openssl rand -hex 24 (Vercel sends it to /api/cron/* automatically)

# Email (Resend) — leave RESEND_API_KEY empty to use the in-app outbox instead
RESEND_API_KEY=""
EMAIL_FROM="PMI Uganda Clubs <clubs@your-verified-domain.org>"

# Optional — Google sign-in (later)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Seeding (npm run db:seed)
SEED_ADMIN_EMAIL=""                        # the single platform administrator
SEED_ADMIN_NAME="Platform Administrator"
SEED_ADMIN_PASSWORD=""                     # 12+ chars; change after first sign-in
SEED_DEMO="false"                          # "true" adds demo members/captains for testing — never in production
