# ─── PMI Uganda Clubs · environment ──────────────────────────────────────────
# Copy to .env.local for local development. In Vercel, Neon + Blob vars are injected by their integrations;
# add the rest under Project → Settings → Environment Variables.

# Neon Postgres — set automatically in Vercel by the Neon integration (Vercel → Storage → Neon).
# For local dev copy them from Neon console → Connect (or `vercel env pull .env.local`).
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob (private store) for uploads — Vercel → Storage → Create Blob store → connect to project.
# Leave empty locally to store uploads on disk under ./storage
BLOB_READ_WRITE_TOKEN=""

# App
APP_URL="http://localhost:3000"           # production: https://your-domain
AUTH_SECRET=""                             # openssl rand -base64 32
CRON_SECRET=""                             # openssl rand -hex 24 (Vercel sends it to /api/cron/* automatically)

# Email (Resend) — leave RESEND_API_KEY empty to use the in-app outbox instead
RESEND_API_KEY=""
EMAIL_FROM="PMI Uganda Clubs <clubs@your-verified-domain.org>"

# Optional — Google sign-in (later)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Seeding — the first Vercel deploy bootstraps an EMPTY database with these (see vercel-build)
SEED_ADMIN_EMAIL=""                        # the single platform administrator
SEED_ADMIN_NAME="Platform Administrator"
SEED_ADMIN_PASSWORD=""                     # 12+ chars; change after first sign-in
SEED_DEMO="false"                          # "true" adds demo members/captains for testing — never in production
